# Node.js Express Web App Dockerfile
FROM node:18-alpine

WORKDIR /app

# Copy package config and install dependencies
COPY package*.json ./
RUN npm ci --omit=dev

# Copy application source files
COPY app.js ./
COPY config/ ./config/
COPY database/ ./database/
COPY middleware/ ./middleware/
COPY views/ ./views/
COPY public/ ./public/
COPY Scrapping_Manual/ ./Scrapping_Manual/

EXPOSE 3000

# Set start command
CMD ["node", "app.js"]
